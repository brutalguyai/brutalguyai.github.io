+
+
+def search_page(term):
+    conn = store.connect()
+    rows = store.search_products(conn, term)
+    items = "".join("<li>" + escape(r[1]) + " " + store.format_price(r[2]) + "</li>" for r in rows)
+    return "<h2>Results for " + term + "</h2><ul>" + items + "</ul>"
+
+
+def greeting(user_id):
