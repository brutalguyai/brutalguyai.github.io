elative\">\n              <div class=\"absolute top-2.5 left-1/2 -translate-x-1/2 w-20 h-[22px] bg-ink rounded-full\"></div>\n              <div class=\"px-5 pt-12 pb-5\">\n                <p class=\"label !text-[10.5px]\" id=\"todayLabel\">Today</p>\n                <h3 class=\"display text-[32px] mt-1\">Morning, Sam</h3>\n\n                <div class=\"mt-5 flex items-end justify-between border-t border-line pt-4\">\n                  <div class=\"flex items-baseline gap-2\">\n                    <span class=\"display text-[76px] leading-[.8]\" id=\"streakNum\">23</span>\n                    <span class=\"label !text-[10.5px]\">day<br/>streak</span>\n                  </div>\n                  <span class=\"label !text-[10.5px]\" id=\"countLabel\">0 / 5</span>\n                </div>\n\n                <div class=\"mt-4 flex gap-1\" id=\"segs\" aria-hidden=\"true\"></div>\n                <div class=\"mt-4 grid grid-cols-7 gap-1\" id=\"weekStrip\"></div>\n\n                <ul id=\"habitList\" class=\"mt-4 border-t border-line\"></ul>\n                <p class=\"mt-3 text-[12px] text-muted\" id=\"streakMsg\">Finish all habits to extend it.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n        <p class=\"label mt-3 text-right !text-[11px]\">\u2191 Interactive \u2014 tap a habit</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- NUMBERS -->\n  <section class=\"border-y border-line\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10 grid grid-cols-2 md:grid-cols-4\">\n      <div class=\"reveal py-8 md:py-10 pr-6 border-b md:border-b-0 border-line\">\n        <div class=\"display text-[56px] md:text-[72px]\" data-count=\"480\" data-suffix=\"K+\">480K+</div>\n        <p class=\"label mt-3\">Active users</p>\n      </div>\n      <div class=\"reveal py-8 md:py-10 pl-6 md:px-8 border-l border-line border-b md:border-b-0\">\n        <div class=\"display text-[56px] md:text-[72px]\" data-count=\"92\" data-suffix=\"M\">92M</div>\n        <p class=\"label mt-3\">Habits completed</p>\n      </div>\n      <div class=\"reveal py-8 md:py-10 pr-6 md:px-8 md:border-l border-line\">\n        <div class=\"display text-[56px] md:text-[72px]\" data-count=\"3.4\" data-suffix=\"\u00d7\">3.4\u00d7</div>\n        <p class=\"label mt-3\">Higher 90-day retention</p>\n      </div>\n      <div class=\"reveal py-8 md:py-10 pl-6 md:pl-8 border-l border-line\">\n        <div class=\"display text-[56px] md:text-[72px]\" data-count=\"4.9\" data-suffix=\"\">4.9</div>\n        <p class=\"label mt-3\">App Store rating</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- FEATURES -->\n  <section id=\"features\" class=\"py-24 md:py-32\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10\">\n      <div class=\"grid md:grid-cols-12 gap-8 items-end reveal\">\n        <div class=\"md:col-span-7\">\n          <p class=\"label\">01 \u2014 Features</p>\n          <h2 class=\"display mt-5 text-[clamp(2.75rem,6vw,4.75rem)]\">Everything you need to stay <em>consistent.</em></h2>\n        </div>\n        <p class=\"md:col-span-4 md:col-start-9 text-[17px] text-muted leading-relaxed\">Built on behavioral science, in an interface you'll actually want to open every day.</p>\n      </div>\n\n      <!-- Heatmap panel -->\n      <div class=\"reveal mt-14 rounded-xl bg-ink text-paper p-7 md:p-10 grid lg:grid-cols-12 gap-10\">\n        <div class=\"lg:col-span-4 flex flex-col\">\n          <p class=\"label on-dark\">Insights</p>\n          <h3 class=\"display text-[40px] mt-4\">Your year, at a glance.</h3>\n          <p class=\"mt-4 text-paper/65 leading-relaxed\">A heatmap of every day you showed up. Watch it fill in over the weeks \u2014 it's quietly satisfying.</p>\n          <dl class=\"mt-8 lg:mt-auto grid grid-cols-2 gap-6 pt-8 border-t border-paper/15\">\n            <div><dt class=\"label on-dark\">Longest streak</dt><dd class=\"display text-4xl mt-2\">41 <span class=\"text-lg text-paper/50 font-sans tracking-normal\">days</span></dd></div>\n            <div><dt class=\"label on-dark\">Active days</dt><dd class=\"display text-4xl mt-2\">168 <span class=\"text-lg text-paper/50 font-sans tracking-normal\">/ 210</span></dd></div>\n          </dl>\n        </div>\n        <div class=\"lg:col-span-8 flex flex-col justify-center\">\n          <div id=\"heatmap\" class=\"grid gap-[5px]\"></div>\n          <div class=\"mt-5 flex flex-wrap items-center justify-between gap-3 label on-dark\">\n            <span>30 weeks ago \u2192 this week</span>\n            <span class=\"flex items-center gap-1.5\" id=\"legend\">Less</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Feature grid -->\n      <div class=\"mt-16 grid md:grid-cols-2 border-t border-line\">\n        <article class=\"reveal p-8 md:p-10 border-b border-line md:border-r\">\n          <div class=\"flex items-center justify-between\">\n            <svg class=\"w-7 h-7\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9\"/></svg>\n            <span class=\"label\">A</span>\n          </div>\n          <h3 class=\"display text-[34px] mt-8\">Streak Freeze</h3>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-md\">Life happens. Earn freezes by staying consistent and protect your streak on the days you can't.</p>\n          <div class=\"mt-8 flex items-center gap-4\">\n            <div class=\"flex gap-1.5\" aria-hidden=\"true\"><span class=\"w-6 h-6 rounded-md bg-ink\"></span><span class=\"w-6 h-6 rounded-md bg-ink\"></span><span class=\"w-6 h-6 rounded-md border border-line\"></span></div>\n            <span class=\"label\">2 of 3 ready \u00b7 auto-use</span>\n          </div>\n        </article>\n\n        <article class=\"reveal p-8 md:p-10 border-b border-line\">\n          <div class=\"flex items-center justify-between\">\n            <svg class=\"w-7 h-7\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 16v-5a6 6 0 1 1 12 0v5l1.500 2h-15L6 16Z\"/><path d=\"M10 21h4\"/></svg>\n            <span class=\"label\">B</span>\n          </div>\n          <h3 class=\"display text-[34px] mt-8\">Smart reminders</h3>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-md\">Streakly learns when you're most likely to follow through and nudges you at exactly the right moment.</p>\n          <div class=\"mt-8 flex items-center gap-4 border border-line rounded-lg px-4 py-3 max-w-sm\">\n            <span class=\"font-mono text-[13px] text-ember\">07:40</span>\n            <div class=\"text-[14px] leading-snug\"><span class=\"font-medium\">Time to stretch.</span> <span class=\"text-muted\">You usually do this around now.</span></div>\n          </div>\n        </article>\n\n        <article class=\"reveal p-8 md:p-10 border-b border-line md:border-r\">\n          <div class=\"flex items-center justify-between\">\n            <svg class=\"w-7 h-7\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"13\" y=\"4\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"4\" y=\"13\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"13\" y=\"13\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>\n            <span class=\"label\">C</span>\n          </div>\n          <h3 class=\"display text-[34px] mt-8\">Widgets &amp; Watch</h3>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-md\">Check in from your lock screen, home screen, or wrist. One tap and you're done \u2014 no app opening required.</p>\n          <div class=\"mt-8 grid grid-cols-3 gap-2 max-w-sm\">\n            <div class=\"border border-line rounded-lg p-3\"><div class=\"label !text-[10px]\">Lock</div><div class=\"font-mono text-[13px] mt-3\">Water 6/8</div></div>\n            <div class=\"border border-line rounded-lg p-3\"><div class=\"label !text-[10px]\">Home</div><div class=\"font-mono text-[13px] mt-3\">Read \u2713</div></div>\n            <div class=\"border border-line rounded-lg p-3\"><div class=\"label !text-[10px]\">Watch</div><div class=\"font-mono text-[13px] mt-3\">Run 3.1k</div></div>\n          </div>\n        </article>\n\n        <article class=\"reveal p-8 md:p-10 border-b border-line\">\n          <div class=\"flex items-center justify-between\">\n            <svg class=\"w-7 h-7\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 20c0-3.300 2.700-6 6-6s6 2.700 6 6\"/><circle cx=\"17\" cy=\"9\" r=\"2.500\"/><path d=\"M17 14c2.500 0 4.500 2 4.500 5\"/></svg>\n            <span class=\"label\">D</span>\n          </div>\n          <h3 class=\"display text-[34px] mt-8\">Accountability circles</h3>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-md\">Invite friends, cheer each other on, and keep group streaks alive. Friendly competition, zero guilt trips.</p>\n          <div class=\"mt-8 max-w-sm font-mono text-[13px] border-t border-line\">\n            <div class=\"flex justify-between py-2.5 border-b border-line\"><span>01 &nbsp;Jordan</span><span>112 days</span></div>\n            <div class=\"flex justify-between py-2.5 border-b border-line text-ember\"><span>02 &nbsp;You</span><span>23 days</span></div>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- HOW IT WORKS -->\n  <section id=\"how\" class=\"py-24 md:py-32 bg-paper2\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10\">\n      <div class=\"reveal\">\n        <p class=\"label\">02 \u2014 How it works</p>\n        <h2 class=\"display mt-5 text-[clamp(2.75rem,6vw,4.75rem)]\">Start small. <em>Snowball big.</em></h2>\n      </div>\n      <div class=\"mt-16 grid md:grid-cols-3 border-t border-ink/25\">\n        <div class=\"reveal pt-7 pb-10 md:pr-10\">\n          <p class=\"font-mono text-[13px] text-ember\">01</p>\n          <h3 class=\"display text-[36px] mt-6\">Pick your habits</h3>\n          <p class=\"mt-3 text-muted leading-relaxed\">Choose from 100+ templates or create your own. We'll help you start tiny so success feels easy.</p>\n        </div>\n        <div class=\"reveal pt-7 pb-10 md:px-10 md:border-l border-ink/25\" style=\"transition-delay:.08s\">\n          <p class=\"font-mono text-[13px] text-ember\">02</p>\n          <h3 class=\"display text-[36px] mt-6\">Check in daily</h3>\n          <p class=\"mt-3 text-muted leading-relaxed\">One tap from your phone, widget, or watch. Each check-in feeds your streak and earns XP.</p>\n        </div>\n        <div class=\"reveal pt-7 pb-10 md:pl-10 md:border-l border-ink/25\" style=\"transition-delay:.16s\">\n          <p class=\"font-mono text-[13px] text-ember\">03</p>\n          <h3 class=\"display text-[36px] mt-6\">Watch yourself grow</h3>\n          <p class=\"mt-3 text-muted leading-relaxed\">Unlock badges, level up, and see insights that show exactly how far you've come.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- REVIEWS -->\n  <section id=\"reviews\" class=\"py-24 md:py-32\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10\">\n      <div class=\"reveal\">\n        <p class=\"label\">03 \u2014 Reviews</p>\n        <h2 class=\"display mt-5 text-[clamp(2.75rem,6vw,4.75rem)]\">People are actually <em>sticking</em> with it.</h2>\n      </div>\n      <div class=\"mt-16 grid lg:grid-cols-12 gap-12 lg:gap-16\">\n        <figure class=\"reveal lg:col-span-7\">\n          <blockquote class=\"display !leading-[1.12] text-[clamp(1.9rem,3.6vw,3rem)]\">\u201cI've tried every habit app out there. Streakly is the first one I've opened every single day for over a year. The streak freeze is genius.\u201d</blockquote>\n          <figcaption class=\"mt-8 flex items-center gap-4\">\n            <span class=\"w-11 h-11 rounded-full bg-ink text-paper grid place-items-center font-mono text-[12px]\">AM</span>\n            <div class=\"text-[14px]\"><div class=\"font-semibold\">Alex Martinez</div><div class=\"label !text-[11px] mt-1\">Product designer \u00b7 412-day streak</div></div>\n          </figcaption>\n        </figure>\n        <div class=\"lg:col-span-5 border-t border-ink/25\">\n          <figure class=\"reveal py-8 border-b border-line\">\n            <blockquote class=\"text-[17px] leading-relaxed\">\u201cThe accountability circles changed everything. My running group keeps each other honest and we've logged 3,000 miles together.\u201d</blockquote>\n            <figcaption class=\"mt-5 text-[14px]\"><span class=\"font-semibold\">Jordan Kim</span> <span class=\"label !text-[11px] ml-2\">Marathoner \u00b7 268 days</span></figcaption>\n          </figure>\n          <figure class=\"reveal py-8 border-b border-line\" style=\"transition-delay:.08s\">\n            <blockquote class=\"text-[17px] leading-relaxed\">\u201cGorgeous, fast, and it doesn't nag me. The smart reminders somehow know exactly when I need a push. Worth every penny of Pro.\u201d</blockquote>\n            <figcaption class=\"mt-5 text-[14px]\"><span class=\"font-semibold\">Sara Lindqvist</span> <span class=\"label !text-[11px] ml-2\">Founder \u00b7 189 days</span></figcaption>\n          </figure>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PRICING -->\n  <section id=\"pricing\" class=\"py-24 md:py-32 border-t border-line\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10\">\n      <div class=\"reveal flex flex-col md:flex-row md:items-end justify-between gap-8\">\n        <div>\n          <p class=\"label\">04 \u2014 Pricing</p>\n          <h2 class=\"display mt-5 text-[clamp(2.75rem,6vw,4.75rem)]\">Simple pricing. <em>Serious results.</em></h2>\n          <p class=\"mt-4 text-muted text-[17px]\">Start free. Upgrade when you're ready to go all in.</p>\n        </div>\n        <div class=\"inline-flex self-start md:self-auto border border-line rounded-lg p-1 text-[14px]\" role=\"group\" aria-label=\"Billing period\">\n          <button id=\"mBtn\" class=\"px-4 py-2 rounded-md font-medium transition-colors\">Monthly</button>\n          <button id=\"yBtn\" class=\"px-4 py-2 rounded-md font-medium transition-colors flex items-center gap-2\">Yearly <span class=\"font-mono text-[11px] text-ember\">\u221233%</span></button>\n        </div>\n      </div>\n\n      <div class=\"reveal mt-12 grid md:grid-cols-3 border border-ink/25 rounded-xl overflow-hidden\">\n        <div class=\"p-8 md:p-9 flex flex-col\">\n          <h3 class=\"font-semibold\">Starter</h3>\n          <p class=\"text-muted text-[14px] mt-1\">For getting your first streak going.</p>\n          <div class=\"mt-8 flex items-baseline gap-2\"><span class=\"display text-[64px]\">$0</span><span class=\"label\">/ forever</span></div>\n          <p class=\"text-[12px] text-muted mt-1 h-4\">&nbsp;</p>\n          <ul class=\"mt-6 space-y-3 text-[14.5px] flex-1\">\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Up to 5 habits</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Daily streak tracking</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Basic reminders</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>30-day history</li>\n          </ul>\n          <a href=\"#cta\" class=\"btn btn-line mt-9\">Get started free</a>\n        </div>\n\n        <div class=\"p-8 md:p-9 flex flex-col bg-ink text-paper border-y md:border-y-0 md:border-x border-ink/25\">\n          <div class=\"flex items-center justify-between\">\n            <h3 class=\"font-semibold\">Pro</h3>\n            <span class=\"font-mono text-[11px] uppercase tracking-wider text-ember\">Most popular</span>\n          </div>\n          <p class=\"text-paper/60 text-[14px] mt-1\">For people serious about change.</p>\n          <div class=\"mt-8 flex items-baseline gap-2\"><span class=\"display text-[64px]\" id=\"proPrice\">$3.99</span><span class=\"label on-dark\">/ month</span></div>\n          <p class=\"text-[12px] text-paper/55 mt-1 h-4\" id=\"proNote\">Billed $47.88 yearly</p>\n          <ul class=\"mt-6 space-y-3 text-[14.5px] flex-1\">\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Unlimited habits</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Streak Freeze &amp; Smart Reminders</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Full-year heatmap &amp; insights</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Widgets &amp; Apple Watch app</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Accountability circles</li>\n          </ul>\n          <a href=\"#cta\" class=\"btn btn-ember mt-9\">Start 14-day free trial</a>\n        </div>\n\n        <div class=\"p-8 md:p-9 flex flex-col\">\n          <h3 class=\"font-semibold\">Family</h3>\n          <p class=\"text-muted text-[14px] mt-1\">Up to 6 people, one plan.</p>\n          <div class=\"mt-8 flex items-baseline gap-2\"><span class=\"display text-[64px]\" id=\"famPrice\">$6.67</span><span class=\"label\">/ month</span></div>\n          <p class=\"text-[12px] text-muted mt-1 h-4\" id=\"famNote\">Billed $80.00 yearly</p>\n          <ul class=\"mt-6 space-y-3 text-[14.5px] flex-1\">\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Everything in Pro</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>6 individual accounts</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Shared family challenges</li>\n            <li class=\"flex gap-3\"><svg class=\"w-4 h-4 mt-1 shrink-0 text-ember\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>Priority support</li>\n          </ul>\n          <a href=\"#cta\" class=\"btn btn-line mt-9\">Choose Family</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section id=\"faq\" class=\"py-24 md:py-32 bg-paper2\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10 grid md:grid-cols-12 gap-12\">\n      <div class=\"md:col-span-4 reveal\">\n        <p class=\"label\">05 \u2014 FAQ</p>\n        <h2 class=\"display mt-5 text-[clamp(2.75rem,5vw,4rem)]\">Questions? <em>Answered.</em></h2>\n        <p class=\"mt-5 text-muted leading-relaxed max-w-xs\">Something else on your mind? Write to <a href=\"#\" class=\"text-ink underline underline-offset-4 decoration-ember\">help@streakly.app</a>.</p>\n      </div>\n      <div class=\"md:col-span-8 reveal border-t border-ink/25\">\n        <details class=\"group border-b border-line py-6\" open>\n          <summary class=\"flex items-center justify-between gap-6 text-[19px] font-medium\">What happens if I miss a day?<span class=\"plus font-mono text-2xl text-ember leading-none\">+</span></summary>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-2xl\">No shame spirals here. If you have a Streak Freeze, it's used automatically. If not, your streak resets \u2014 but your longest streak and all your history stay safe, and we'll help you bounce back with a gentle \"comeback\" plan.</p>\n        </details>\n        <details class=\"group border-b border-line py-6\">\n          <summary class=\"flex items-center justify-between gap-6 text-[19px] font-medium\">Is the free plan really free?<span class=\"plus font-mono text-2xl text-ember leading-none\">+</span></summary>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-2xl\">Yes \u2014 forever. Track up to 5 habits with streaks and reminders at no cost, no credit card required. Upgrade only if you want unlimited habits and the advanced features.</p>\n        </details>\n        <details class=\"group border-b border-line py-6\">\n          <summary class=\"flex items-center justify-between gap-6 text-[19px] font-medium\">Does Streakly work on Android and web?<span class=\"plus font-mono text-2xl text-ember leading-none\">+</span></summary>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-2xl\">Streakly is available on iOS and Android, with a web dashboard and Apple Watch / Wear OS companions. Everything syncs instantly across your devices.</p>\n        </details>\n        <details class=\"group border-b border-line py-6\">\n          <summary class=\"flex items-center justify-between gap-6 text-[19px] font-medium\">Is my data private?<span class=\"plus font-mono text-2xl text-ember leading-none\">+</span></summary>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-2xl\">Absolutely. Your data is encrypted in transit and at rest, we never sell it, and you can export or delete everything with a single tap.</p>\n        </details>\n        <details class=\"group border-b border-line py-6\">\n          <summary class=\"flex items-center justify-between gap-6 text-[19px] font-medium\">Can I cancel anytime?<span class=\"plus font-mono text-2xl text-ember leading-none\">+</span></summary>\n          <p class=\"mt-3 text-muted leading-relaxed max-w-2xl\">Of course. Cancel from your account settings in seconds. You'll keep Pro features until the end of your billing period and drop back to the free plan afterward.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <!-- CTA -->\n  <section id=\"cta\" class=\"bg-ink text-paper py-24 md:py-32\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10 grid lg:grid-cols-12 gap-12 items-end\">\n      <div class=\"lg:col-span-7 reveal\">\n        <p class=\"label on-dark\">Get started</p>\n        <h2 class=\"display mt-5 text-[clamp(3.25rem,8vw,6.5rem)]\">Day one starts <em>today.</em></h2>\n        <p class=\"mt-6 text-[18px] text-paper/65 max-w-lg leading-relaxed\">Join 480,000+ people turning small daily actions into a life they're proud of. Free to start. Takes 30 seconds.</p>\n      </div>\n      <div class=\"lg:col-span-5 reveal\">\n        <form id=\"waitForm\" class=\"flex flex-col sm:flex-row gap-3\">\n          <label for=\"email\" class=\"sr-only\">Email address</label>\n          <input id=\"email\" type=\"email\" required placeholder=\"you@email.com\" class=\"flex-1 min-w-0 bg-transparent border border-paper/30 rounded-lg px-4 py-3.5 text-paper placeholder-paper/40 focus:outline-none focus:border-ember\" />\n          <button class=\"btn btn-ember !py-3.5\">Get the app</button>\n        </form>\n        <p id=\"formMsg\" class=\"mt-4 text-[14px] text-paper/55 min-h-[20px]\">We'll send a download link. No spam, ever.</p>\n      </div>\n    </div>\n  </section>\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"bg-ink text-paper border-t border-paper/15 pt-14 pb-10\">\n    <div class=\"mx-auto max-w-[1180px] px-6 md:px-10\">\n      <div class=\"grid sm:grid-cols-2 md:grid-cols-5 gap-10\">\n        <div class=\"md:col-span-2\">\n          <a href=\"#top\" class=\"font-serif text-[28px] leading-none\">Streakly<span class=\"text-ember\">.</span></a>\n          <p class=\"mt-4 text-paper/60 text-[14px] max-w-xs leading-relaxed\">The habit tracker that makes consistency addictive. Built with care for people who want to grow.</p>\n        </div>\n        <div>\n          <h4 class=\"label on-dark\">Product</h4>\n          <ul class=\"mt-4 space-y-2.5 text-[14px] text-paper/70\">\n            <li><a href=\"#features\" class=\"hover:text-paper\">Features</a></li>\n            <li><a href=\"#pricing\" class=\"hover:text-paper\">Pricing</a></li>\n            <li><a href=\"#how\" class=\"hover:text-paper\">How it works</a></li>\n            <li><a href=\"#\" class=\"hover:text-paper\">Changelog</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4 class=\"label on-dark\">Company</h4>\n          <ul class=\"mt-4 space-y-2.5 text-[14px] text-paper/70\">\n            <li><a href=\"#\" class=\"hover:text-paper\">About</a></li>\n            <li><a href=\"#\" class=\"hover:text-paper\">Blog</a></li>\n            <li><a href=\"#\" class=\"hover:text-paper\">Careers</a></li>\n            <li><a href=\"#\" class=\"hover:text-paper\">Press kit</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4 class=\"label on-dark\">Legal</h4>\n          <ul class=\"mt-4 space-y-2.5 text-[14px] text-paper/70\">\n            <li><a href=\"#\" class=\"hover:text-paper\">Privacy</a></li>\n            <li><a href=\"#\" class=\"hover:text-paper\">Terms</a></li>\n            <li><a href=\"#\" class=\"hover:text-paper\">Security</a></li>\n            <li><a href=\"#\" class=\"hover:text-paper\">Contact</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"mt-14 pt-6 border-t border-paper/15 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[13px] text-paper/50\">\n        <p>\u00a9 <span id=\"year\"></span> Streakly, Inc. Keep the streak alive.</p>\n        <div class=\"flex gap-6\">\n          <a href=\"#\" class=\"hover:text-paper\">Twitter / X</a>\n          <a href=\"#\" class=\"hover:text-paper\">Instagram</a>\n          <a href=\"#\" class=\"hover:text-paper\">TikTok</a>\n          <a href=\"#\" class=\"hover:text-paper\">YouTube</a>\n        </div>\n      </div>\n    </div>\n  </footer>\n\n  <script>\n    // Year + date label\n    document.getElementById('year').textContent = new Date().getFullYear();\n    document.getElementById('todayLabel').textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'short', day: 'numeric' });\n\n    // Mobile menu\n    const menuBtn = document.getElementById('menuBtn'), mobileMenu = document.getElementById('mobileMenu');\n    menuBtn.addEventListener('click', () => {\n      const open = mobileMenu.classList.toggle('hidden') === false;\n      menuBtn.setAttribute('aria-expanded', open);\n    });\n    mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileMenu.classList.add('hidden')));\n\n    // Interactive habits\n    const habits = [\n      { name: 'Drink 2L of water', meta: 'Health', done: true },\n      { name: 'Read 20 pages', meta: 'Learning', done: true },\n      { name: 'Meditate 10 min', meta: 'Mindfulness', done: false },\n      { name: 'Run 5k', meta: 'Fitness', done: false },\n      { name: 'Write in journal', meta: 'Reflection', done: false },\n    ];\n    const list = document.getElementById('habitList');\n    const segs = document.getElementById('segs');\n    const week = document.getElementById('weekStrip');\n    const baseStreak = 23;\n    const tickSvg = '<svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"white\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>';\n\n    habits.forEach((h, i) => {\n      const li = document.createElement('li');\n      li.className = 'habit-row' + (h.done ? ' done' : '');\n      li.innerHTML = `\n        <button type=\"button\" class=\"habit-btn\" aria-pressed=\"${h.done}\">\n          <span class=\"habit-check\">${tickSvg}</span>\n          <span class=\"flex-1 min-w-0\">\n            <span class=\"habit-name block text-[14px] font-medium truncate transition-colors\">${h.name}</span>\n          </span>\n          <span class=\"font-mono text-[10px] uppercase tracking-wider text-muted\">${h.meta}</span>\n        </button>`;\n      li.querySelector('button').addEventListener('click', (e) => {\n        h.done = !h.done;\n        li.classList.toggle('done', h.done);\n        e.currentTarget.setAttribute('aria-pressed', h.done);\n        update();\n      });\n      list.appendChild(li);\n      const s = document.createElement('span');\n      s.className = 'seg flex-1 h-1.5 rounded-full bg-ink/10';\n      segs.appendChild(s);\n    });\n\n    // Week strip (last 7 days ending today)\n    const dayEls = [];\n    for (let i = 6; i >= 0; i--) {\n      const d = new Date(); d.setDate(d.getDate() - i);\n      const col = document.createElement('div');\n      col.className = 'flex flex-col items-center gap-1.5';\n      const letter = d.toLocaleDateString(undefined, { weekday: 'narrow' });\n      const isToday = i === 0;\n      col.innerHTML = `<span class=\"font-mono text-[10px] text-muted\">${letter}</span>\n        <span class=\"w-[26px] h-[26px] rounded-full grid place-items-center font-mono text-[10px] transition-colors ${isToday ? 'border border-ember text-ember' : 'bg-ink text-white'}\">${isToday ? d.getDate() : tickSvg.replace('13','11').replace('13','11')}</span>`;\n      week.appendChild(col);\n      if (isToday) dayEls.push({ el: col.lastElementChild, date: d.getDate() });\n    }\n\n    function update() {\n      const done = habits.filter(h => h.done).length;\n      const all = done === habits.length;\n      document.getElementById('countLabel').textContent = `${done} / ${habits.length}`;\n      [...segs.children].forEach((s, i) => {\n        s.className = 'seg flex-1 h-1.5 rounded-full ' + (i < done ? 'bg-ember' : 'bg-ink/10');\n      });\n      document.getElementById('streakNum').textContent = baseStreak + (all ? 1 : 0);\n      document.getElementById('streakMsg').textContent = all ? 'Streak extended. Nicely done.' : `${habits.length - done} to go to extend your streak.`;\n      const t = dayEls[0];\n      if (all) {\n        t.el.className = 'w-[26px] h-[26px] rounded-full grid place-items-center bg-ember transition-colors';\n        t.el.innerHTML = tickSvg.replace('13','11').replace('13','11');\n      } else {\n        t.el.className = 'w-[26px] h-[26px] rounded-full grid place-items-center font-mono text-[10px] border border-ember text-ember transition-colors';\n        t.el.textContent = t.date;\n      }\n    }\n    update();\n\n    // Heatmap\n    const hm = document.getElementById('heatmap');\n    const colors = ['#26231d', '#5a2a1b', '#8f321a', '#c93b1b', '#ff5a2c'];\n    const legend = document.getElementById('legend');\n    legend.innerHTML = 'Less ' + colors.map(c => `<span style=\"display:inline-block;width:12px;height:12px;border-radius:3px;background:${c}\"></span>`).join('') + ' More';\n    let seed = 7;\n    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;\n    const weeks = 30;\n    for (let w = 0; w < weeks; w++) {\n      for (let d = 0; d < 7; d++) {\n        const trend = 0.35 + (w / weeks) * 0.6;\n        const r = rnd();\n        let lvl = r > trend + 0.2 ? 0 : r > trend ? 1 : r > trend * 0.6 ? 2 : r > trend * 0.3 ? 3 : 4;\n        if (rnd() < trend * 0.55) lvl = Math.max(lvl, 3 + (rnd() > .5 ? 1 : 0));\n        if (rnd() < 0.08) lvl = 0;\n        const cell = document.createElement('span');\n        cell.className = 'block aspect-square rounded-[3px]';\n        cell.style.background = colors[lvl];\n        hm.appendChild(cell);\n      }\n    }\n    hm.style.gridTemplateColumns = `repeat(${weeks}, minmax(0, 1fr))`;\n    hm.style.gridTemplateRows = 'repeat(7, auto)';\n    hm.style.gridAutoFlow = 'column';\n\n    // Reveal on scroll\n    const io = new IntersectionObserver((entries) => {\n      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });\n    }, { threshold: 0.1 });\n    document.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n    // Count up\n    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const cio = new IntersectionObserver((entries) => {\n      entries.forEach(e => {\n        if (!e.isIntersecting) return;\n        const el = e.target, target = parseFloat(el.dataset.count), suffix = el.dataset.suffix || '';\n        const dec = String(target).includes('.') ? 1 : 0, start = performance.now(), dur = 1200;\n        const tick = (t) => {\n          const p = Math.min((t - start) / dur, 1), eased = 1 - Math.pow(1 - p, 3);\n          el.textContent = (target * eased).toFixed(dec) + suffix;\n          if (p < 1) requestAnimationFrame(tick);\n        };\n        requestAnimationFrame(tick);\n        cio.unobserve(el);\n      });\n    }, { threshold: 0.6 });\n    if (!reduce) document.querySelectorAll('[data-count]').forEach(el => cio.observe(el));\n\n    // Pricing toggle\n    const mBtn = document.getElementById('mBtn'), yBtn = document.getElementById('yBtn');\n    function setBilling(yearly) {\n      document.getElementById('proPrice').textContent = yearly ? '$3.99' : '$5.99';\n      document.getElementById('famPrice').textContent = yearly ? '$6.67' : '$9.99';\n      document.getElementById('proNote').textContent = yearly ? 'Billed $47.88 yearly' : 'Billed monthly';\n      document.getElementById('famNote').textContent = yearly ? 'Billed $80.00 yearly' : 'Billed monthly';\n      const on = 'bg-ink text-paper', off = 'text-muted hover:text-ink';\n      mBtn.className = 'px-4 py-2 rounded-md font-medium transition-colors ' + (yearly ? off : on);\n      yBtn.className = 'px-4 py-2 rounded-md font-medium transition-colors flex items-center gap-2 ' + (yearly ? on : off);\n      mBtn.setAttribute('aria-pressed', !yearly);\n      yBtn.setAttribute('aria-pressed', yearly);\n    }\n    mBtn.addEventListener('click', () => setBilling(false));\n    yBtn.addEventListener('click', () => setBilling(true));\n    setBilling(true);\n\n    // Email form\n    document.getElementById('waitForm').addEventListener('submit', (e) => {\n      e.preventDefault();\n      const msg = document.getElementById('formMsg');\n      msg.textContent = \"You're in. Check your inbox for the download link.\";\n      msg.style.color = '#f3efe6';\n      e.target.reset();\n    });\n  </script>\n</body>\n</html>\n```"}