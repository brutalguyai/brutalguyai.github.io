13.63\" stroke-dashoffset=\"213.63\"/>\n                    <defs><linearGradient id=\"g\" x1=\"0\" x2=\"1\"><stop offset=\"0\" stop-color=\"#ffb347\"/><stop offset=\".5\" stop-color=\"#ff4d7e\"/><stop offset=\"1\" stop-color=\"#8b5cf6\"/></linearGradient></defs>\n                  </svg>\n                  <div class=\"absolute inset-0 grid place-items-center font-display font-bold text-lg\" id=\"pct\">0%</div>\n                </div>\n                <div>\n                  <div class=\"flex items-center gap-2\">\n                    <span class=\"text-3xl inline-block animate-flicker\">\ud83d\udd25</span>\n                    <span class=\"font-display text-4xl font-bold\" id=\"streakNum\">23</span>\n                    <span class=\"text-sm text-zinc-400\">day streak</span>\n                  </div>\n                  <p class=\"text-xs text-zinc-400 mt-1\" id=\"streakMsg\">Finish all habits to extend it.</p>\n                </div>\n              </div>\n\n              <div class=\"mt-5 flex items-center justify-between\">\n                <h4 class=\"font-semibold text-sm\">Today's habits</h4>\n                <span class=\"text-xs text-zinc-500\" id=\"countLabel\">0 / 5</span>\n              </div>\n              <ul id=\"habitList\" class=\"mt-3 space-y-2.5\"></ul>\n              <p class=\"text-center text-[11px] text-zinc-500 mt-4\">\ud83d\udc46 Go on, tap them \u2014 it's interactive.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- MARQUEE -->\n  <section class=\"relative border-y border-white/5 bg-white/[0.02] py-6 overflow-hidden\">\n    <p class=\"text-center text-xs uppercase tracking-[.25em] text-zinc-500 mb-4\">As seen in</p>\n    <div class=\"flex w-max animate-marquee gap-16 text-zinc-500 font-display text-2xl font-bold whitespace-nowrap\">\n      <span>TechCrunch</span><span>The Verge</span><span>Product Hunt</span><span>Wired</span><span>Fast Company</span><span>Lifehacker</span><span>Mashable</span><span>Forbes</span>\n      <span>TechCrunch</span><span>The Verge</span><span>Product Hunt</span><span>Wired</span><span>Fast Company</span><span>Lifehacker</span><span>Mashable</span><span>Forbes</span>\n    </div>\n  </section>\n\n  <!-- STATS -->\n  <section class=\"py-20\">\n    <div class=\"mx-auto max-w-6xl px-4 grid grid-cols-2 md:grid-cols-4 gap-6 text-center\">\n      <div class=\"reveal\"><div class=\"font-display text-4xl sm:text-5xl font-bold grad-text\" data-count=\"480\" data-suffix=\"K+\">0</div><p class=\"text-zinc-400 mt-2 text-sm\">Active users</p></div>\n      <div class=\"reveal\"><div class=\"font-display text-4xl sm:text-5xl font-bold grad-text\" data-count=\"92\" data-suffix=\"M\">0</div><p class=\"text-zinc-400 mt-2 text-sm\">Habits completed</p></div>\n      <div class=\"reveal\"><div class=\"font-display text-4xl sm:text-5xl font-bold grad-text\" data-count=\"3.4\" data-suffix=\"x\">0</div><p class=\"text-zinc-400 mt-2 text-sm\">Higher 90-day retention</p></div>\n      <div class=\"reveal\"><div class=\"font-display text-4xl sm:text-5xl font-bold grad-text\" data-count=\"4.9\" data-suffix=\"\u2605\">0</div><p class=\"text-zinc-400 mt-2 text-sm\">App Store rating</p></div>\n    </div>\n  </section>\n\n  <!-- FEATURES -->\n  <section id=\"features\" class=\"relative py-24\">\n    <div class=\"blob w-[420px] h-[420px] bg-violet-600/30 right-0 top-40\"></div>\n    <div class=\"relative mx-auto max-w-6xl px-4\">\n      <div class=\"max-w-2xl mx-auto text-center reveal\">\n        <p class=\"text-sm font-semibold uppercase tracking-widest text-flame\">Features</p>\n        <h2 class=\"mt-3 font-display text-4xl sm:text-5xl font-bold tracking-tight\">Everything you need to <span class=\"grad-text\">stay consistent</span></h2>\n        <p class=\"mt-4 text-zinc-400 text-lg\">Designed with behavioral science, wrapped in an interface you'll actually want to open every day.</p>\n      </div>\n\n      <div class=\"mt-16 grid md:grid-cols-6 gap-5\">\n        <!-- Heatmap -->\n        <div class=\"card reveal rounded-3xl p-7 md:col-span-4\">\n          <div class=\"flex items-start justify-between gap-4\">\n            <div>\n              <h3 class=\"font-display text-2xl font-bold\">Your year, at a glance</h3>\n              <p class=\"text-zinc-400 mt-2 max-w-md\">A beautiful heatmap shows every day you showed up. Watch it fill with color \u2014 it's weirdly satisfying.</p>\n            </div>\n            <span class=\"shrink-0 text-xs glass rounded-full px-3 py-1 text-zinc-300\">Insights</span>\n          </div>\n          <div id=\"heatmap\" class=\"mt-6 grid grid-flow-col grid-rows-7 gap-1.5 overflow-hidden\"></div>\n          <div class=\"mt-4 flex items-center justify-end gap-2 text-xs text-zinc-500\">\n            Less\n            <span class=\"w-3 h-3 rounded-[4px]\" style=\"background:rgba(255,255,255,.07)\"></span>\n            <span class=\"w-3 h-3 rounded-[4px]\" style=\"background:rgba(255,106,61,.35)\"></span>\n            <span class=\"w-3 h-3 rounded-[4px]\" style=\"background:rgba(255,106,61,.6)\"></span>\n            <span class=\"w-3 h-3 rounded-[4px]\" style=\"background:rgba(255,77,126,.85)\"></span>\n            <span class=\"w-3 h-3 rounded-[4px]\" style=\"background:#8b5cf6\"></span>\n            More\n          </div>\n        </div>\n\n        <!-- Streak freeze -->\n        <div class=\"card reveal rounded-3xl p-7 md:col-span-2 relative overflow-hidden\">\n          <div class=\"text-5xl animate-float\">\ud83e\uddca</div>\n          <h3 class=\"font-display text-2xl font-bold mt-5\">Streak Freeze</h3>\n          <p class=\"text-zinc-400 mt-2\">Life happens. Earn freezes by staying consistent and protect your streak on the days you can't.</p>\n          <div class=\"mt-5 flex gap-2\">\n            <span class=\"px-3 py-1 rounded-full text-xs bg-sky-400/15 text-sky-300 border border-sky-400/20\">2 available</span>\n            <span class=\"px-3 py-1 rounded-full text-xs bg-white/5 text-zinc-300 border border-white/10\">Auto-use</span>\n          </div>\n        </div>\n\n        <!-- Smart reminders -->\n        <div class=\"card reveal rounded-3xl p-7 md:col-span-2\">\n          <div class=\"w-12 h-12 rounded-2xl grad-bg grid place-items-center text-2xl shadow-lg shadow-rose-500/30\">\u23f0</div>\n          <h3 class=\"font-display text-2xl font-bold mt-5\">Smart reminders</h3>\n          <p class=\"text-zinc-400 mt-2\">Streakly learns when you're most likely to follow through and nudges you at exactly the right moment.</p>\n          <div class=\"mt-5 glass rounded-2xl p-3 flex items-center gap-3 text-sm\">\n            <span class=\"text-xl\">\ud83d\udd14</span>\n            <div><div class=\"font-medium\">Time to stretch!</div><div class=\"text-xs text-zinc-400\">You usually crush this at 7:40 AM</div></div>\n          </div>\n        </div>\n\n        <!-- Widgets -->\n        <div class=\"card reveal rounded-3xl p-7 md:col-span-2\">\n          <div class=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-500 grid place-items-center text-2xl shadow-lg shadow-violet-500/30\">\ud83e\udde9</div>\n          <h3 class=\"font-display text-2xl font-bold mt-5\">Widgets &amp; Watch</h3>\n          <p class=\"text-zinc-400 mt-2\">Check in from your lock screen, home screen, or wrist. One tap and you're done \u2014 no app opening required.</p>\n          <div class=\"mt-5 grid grid-cols-3 gap-2\">\n            <div class=\"aspect-square rounded-2xl bg-gradient-to-br from-flame/30 to-rose-500/20 border border-white/10 grid place-items-center text-2xl\">\ud83d\udd25</div>\n            <div class=\"aspect-square rounded-2xl bg-white/5 border border-white/10 grid place-items-center text-2xl\">\ud83d\udca7</div>\n            <div class=\"aspect-square rounded-2xl bg-white/5 border border-white/10 grid place-items-center text-2xl\">\ud83d\udcd6</div>\n          </div>\n        </div>\n\n        <!-- Friends -->\n        <div class=\"card reveal rounded-3xl p-7 md:col-span-2\">\n          <div class=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 grid place-items-center text-2xl shadow-lg shadow-emerald-500/30\">\ud83e\udd1d</div>\n          <h3 class=\"font-display text-2xl font-bold mt-5\">Accountability circles</h3>\n          <p class=\"text-zinc-400 mt-2\">Invite friends, cheer each other on, and keep group streaks alive. Friendly competition, zero guilt trips.</p>\n          <div class=\"mt-5 space-y-2 text-sm\">\n            <div class=\"flex items-center justify-between glass rounded-xl px-3 py-2\"><span>\ud83e\udd47 Jordan</span><span class=\"text-flame font-semibold\">112 \ud83d\udd25</span></div>\n            <div class=\"flex items-center justify-between glass rounded-xl px-3 py-2\"><span>\ud83e\udd48 You</span><span class=\"text-flame font-semibold\">23 \ud83d\udd25</span></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- HOW IT WORKS -->\n  <section id=\"how\" class=\"py-24\">\n    <div class=\"mx-auto max-w-6xl px-4\">\n      <div class=\"max-w-2xl mx-auto text-center reveal\">\n        <p class=\"text-sm font-semibold uppercase tracking-widest text-flame\">How it works</p>\n        <h2 class=\"mt-3 font-display text-4xl sm:text-5xl font-bold tracking-tight\">Start small. <span class=\"grad-text\">Snowball big.</span></h2>\n      </div>\n      <div class=\"mt-16 grid md:grid-cols-3 gap-6 relative\">\n        <div class=\"hidden md:block absolute top-12 left-[16%] right-[16%] h-px bg-gradient-to-r from-transparent via-white/20 to-transparent\"></div>\n        <div class=\"reveal text-center px-4\">\n          <div class=\"relative mx-auto w-24 h-24 rounded-3xl glass grid place-items-center text-4xl\">\ud83c\udfaf<span class=\"absolute -top-3 -right-3 w-8 h-8 rounded-full grad-bg text-sm font-bold grid place-items-center\">1</span></div>\n          <h3 class=\"font-display text-xl font-bold mt-6\">Pick your habits</h3>\n          <p class=\"text-zinc-400 mt-2\">Choose from 100+ templates or create your own. We'll help you start tiny so success feels easy.</p>\n        </div>\n        <div class=\"reveal text-center px-4\" style=\"transition-delay:.12s\">\n          <div class=\"relative mx-auto w-24 h-24 rounded-3xl glass grid place-items-center text-4xl\">\u2705<span class=\"absolute -top-3 -right-3 w-8 h-8 rounded-full grad-bg text-sm font-bold grid place-items-center\">2</span></div>\n          <h3 class=\"font-display text-xl font-bold mt-6\">Check in daily</h3>\n          <p class=\"text-zinc-400 mt-2\">One tap from your phone, widget, or watch. Each check-in feeds your streak and earns XP.</p>\n        </div>\n        <div class=\"reveal text-center px-4\" style=\"transition-delay:.24s\">\n          <div class=\"relative mx-auto w-24 h-24 rounded-3xl glass grid place-items-center text-4xl\">\ud83d\ude80<span class=\"absolute -top-3 -right-3 w-8 h-8 rounded-full grad-bg text-sm font-bold grid place-items-center\">3</span></div>\n          <h3 class=\"font-display text-xl font-bold mt-6\">Watch yourself grow</h3>\n          <p class=\"text-zinc-400 mt-2\">Unlock badges, level up, and see insights that show exactly how far you've come.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- TESTIMONIALS -->\n  <section id=\"reviews\" class=\"relative py-24\">\n    <div class=\"blob w-[400px] h-[400px] bg-flame/25 left-0 top-20\"></div>\n    <div class=\"relative mx-auto max-w-6xl px-4\">\n      <div class=\"max-w-2xl mx-auto text-center reveal\">\n        <p class=\"text-sm font-semibold uppercase tracking-widest text-flame\">Reviews</p>\n        <h2 class=\"mt-3 font-display text-4xl sm:text-5xl font-bold tracking-tight\">People are <span class=\"grad-text\">actually sticking</span> with it</h2>\n      </div>\n      <div class=\"mt-14 grid md:grid-cols-3 gap-5\">\n        <figure class=\"card reveal rounded-3xl p-7\">\n          <div class=\"text-amber-400\">\u2605\u2605\u2605\u2605\u2605</div>\n          <blockquote class=\"mt-4 text-zinc-200 leading-relaxed\">\"I've tried every habit app out there. Streakly is the first one I've opened every single day for over a year. The streak freeze is genius.\"</blockquote>\n          <figcaption class=\"mt-6 flex items-center gap-3\">\n            <span class=\"w-10 h-10 rounded-full grid place-items-center font-bold bg-gradient-to-br from-amber-400 to-orange-500\">AM</span>\n            <div class=\"text-sm\"><div class=\"font-semibold\">Alex Martinez</div><div class=\"text-zinc-500\">Product designer \u00b7 412-day streak</div></div>\n          </figcaption>\n        </figure>\n        <figure class=\"card reveal rounded-3xl p-7\" style=\"transition-delay:.1s\">\n          <div class=\"text-amber-400\">\u2605\u2605\u2605\u2605\u2605</div>\n          <blockquote class=\"mt-4 text-zinc-200 leading-relaxed\">\"The accountability circles changed everything. My running group keeps each other honest and we've logged 3,000 miles together.\"</blockquote>\n          <figcaption class=\"mt-6 flex items-center gap-3\">\n            <span class=\"w-10 h-10 rounded-full grid place-items-center font-bold bg-gradient-to-br from-pink-400 to-rose-600\">JK</span>\n            <div class=\"text-sm\"><div class=\"font-semibold\">Jordan Kim</div><div class=\"text-zinc-500\">Marathoner \u00b7 268-day streak</div></div>\n          </figcaption>\n        </figure>\n        <figure class=\"card reveal rounded-3xl p-7\" style=\"transition-delay:.2s\">\n          <div class=\"text-amber-400\">\u2605\u2605\u2605\u2605\u2605</div>\n          <blockquote class=\"mt-4 text-zinc-200 leading-relaxed\">\"Gorgeous, fast, and it doesn't nag me. The smart reminders somehow know exactly when I need a push. Worth every penny of Pro.\"</blockquote>\n          <figcaption class=\"mt-6 flex items-center gap-3\">\n            <span class=\"w-10 h-10 rounded-full grid place-items-center font-bold bg-gradient-to-br from-violet-400 to-indigo-600\">SL</span>\n            <div class=\"text-sm\"><div class=\"font-semibold\">Sara Lindqvist</div><div class=\"text-zinc-500\">Founder \u00b7 189-day streak</div></div>\n          </figcaption>\n        </figure>\n      </div>\n    </div>\n  </section>\n\n  <!-- PRICING -->\n  <section id=\"pricing\" class=\"py-24\">\n    <div class=\"mx-auto max-w-6xl px-4\">\n      <div class=\"max-w-2xl mx-auto text-center reveal\">\n        <p class=\"text-sm font-semibold uppercase tracking-widest text-flame\">Pricing</p>\n        <h2 class=\"mt-3 font-display text-4xl sm:text-5xl font-bold tracking-tight\">Simple pricing. <span class=\"grad-text\">Serious results.</span></h2>\n        <p class=\"mt-4 text-zinc-400 text-lg\">Start free. Upgrade when you're ready to go all in.</p>\n\n        <div class=\"mt-8 inline-flex items-center glass rounded-full p-1 text-sm\">\n          <button id=\"mBtn\" class=\"px-5 py-2 rounded-full font-semibold transition\">Monthly</button>\n          <button id=\"yBtn\" class=\"px-5 py-2 rounded-full font-semibold transition flex items-center gap-2\">Yearly <span class=\"text-[10px] bg-emerald-400/20 text-emerald-300 px-2 py-0.5 rounded-full\">Save 33%</span></button>\n        </div>\n      </div>\n\n      <div class=\"mt-14 grid md:grid-cols-3 gap-6 items-stretch\">\n        <div class=\"card reveal rounded-3xl p-8 flex flex-col\">\n          <h3 class=\"font-display text-xl font-bold\">Starter</h3>\n          <p class=\"text-zinc-400 text-sm mt-1\">For getting your first streak going.</p>\n          <div class=\"mt-6 flex items-baseline gap-1\"><span class=\"font-display text-5xl font-bold\">$0</span><span class=\"text-zinc-500\">/forever</span></div>\n          <ul class=\"mt-8 space-y-3 text-sm text-zinc-300 flex-1\">\n            <li class=\"flex gap-3\"><span class=\"text-emerald-400\">\u2713</span> Up to 5 habits</li>\n            <li class=\"flex gap-3\"><span class=\"text-emerald-400\">\u2713</span> Daily streak