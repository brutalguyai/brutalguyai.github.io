border-white/5 pt-14 pb-10\">\n    <div class=\"mx-auto max-w-6xl px-4\">\n      <div class=\"grid sm:grid-cols-2 md:grid-cols-5 gap-10\">\n        <div class=\"md:col-span-2\">\n          <a href=\"#top\" class=\"flex items-center gap-2 font-display font-bold text-xl\">\n            <span class=\"grid place-items-center w-8 h-8 rounded-xl grad-bg\">\n              <svg viewBox=\"0 0 24 24\" class=\"w-5 h-5\" fill=\"white\"><path d=\"M12 2c.5 3-1 4.8-2.5 6.5C8 10.200 7 11.700 7 14a5 5 0 0 0 10 0c0-1.600-.7-2.900-1.600-4-.3 1.200-1 2-2 2.300C14 9 13.700 4.500 12 2Z\"/></svg>\n            </span>\n            Streakly\n          </a>\n          <p class=\"mt-4 text-zinc-400 text-sm max-w-xs\">The habit tracker that makes consistency addictive. Built with care for people who want to grow.</p>\n        </div>\n        <div>\n          <h4 class=\"font-semibold text-sm\">Product</h4>\n          <ul class=\"mt-4 space-y-2 text-sm text-zinc-400\">\n            <li><a href=\"#features\" class=\"hover:text-white\">Features</a></li>\n            <li><a href=\"#pricing\" class=\"hover:text-white\">Pricing</a></li>\n            <li><a href=\"#how\" class=\"hover:text-white\">How it works</a></li>\n            <li><a href=\"#\" class=\"hover:text-white\">Changelog</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4 class=\"font-semibold text-sm\">Company</h4>\n          <ul class=\"mt-4 space-y-2 text-sm text-zinc-400\">\n            <li><a href=\"#\" class=\"hover:text-white\">About</a></li>\n            <li><a href=\"#\" class=\"hover:text-white\">Blog</a></li>\n            <li><a href=\"#\" class=\"hover:text-white\">Careers</a></li>\n            <li><a href=\"#\" class=\"hover:text-white\">Press kit</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4 class=\"font-semibold text-sm\">Legal</h4>\n          <ul class=\"mt-4 space-y-2 text-sm text-zinc-400\">\n            <li><a href=\"#\" class=\"hover:text-white\">Privacy</a></li>\n            <li><a href=\"#\" class=\"hover:text-white\">Terms</a></li>\n            <li><a href=\"#\" class=\"hover:text-white\">Security</a></li>\n            <li><a href=\"#\" class=\"hover:text-white\">Contact</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"mt-12 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-zinc-500\">\n        <p>\u00a9 <span id=\"year\"></span> Streakly, Inc. Keep the streak alive.</p>\n        <div class=\"flex gap-5\">\n          <a href=\"#\" class=\"hover:text-white\">Twitter / X</a>\n          <a href=\"#\" class=\"hover:text-white\">Instagram</a>\n          <a href=\"#\" class=\"hover:text-white\">TikTok</a>\n          <a href=\"#\" class=\"hover:text-white\">YouTube</a>\n        </div>\n      </div>\n    </div>\n  </footer>\n\n  <script>\n    // Year + date label\n    document.getElementById('year').textContent = new Date().getFullYear();\n    document.getElementById('todayLabel').textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'short', day: 'numeric' });\n\n    // Mobile menu\n    const menuBtn = document.getElementById('menuBtn'), mobileMenu = document.getElementById('mobileMenu');\n    menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));\n    mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileMenu.classList.add('hidden')));\n\n    // Interactive habits\n    const habits = [\n      { icon: '\ud83d\udca7', name: 'Drink 2L of water', meta: 'Health', done: true },\n      { icon: '\ud83d\udcd6', name: 'Read 20 pages', meta: 'Learning', done: true },\n      { icon: '\ud83e\uddd8', name: 'Meditate 10 min', meta: 'Mindfulness', done: false },\n      { icon: '\ud83c\udfc3', name: 'Run 5k', meta: 'Fitness', done: false },\n      { icon: '\u270d\ufe0f', name: 'Write in journal', meta: 'Reflection', done: false },\n    ];\n    const list = document.getElementById('habitList');\n    const ring = document.getElementById('ring');\n    const C = 2 * Math.PI * 34;\n    const baseStreak = 23;\n\n    function render() {\n      list.innerHTML = '';\n      habits.forEach((h, i) => {\n        const li = document.createElement('li');\n        li.className = 'habit-row flex items-center gap-3 rounded-2xl bg-white/[0.04] border border-white/[0.07] p-3 cursor-pointer hover:bg-white/[0.08] transition select-none' + (h.done ? ' done' : '');\n        li.innerHTML = `\n          <span class=\"w-10 h-10 rounded-xl bg-white/5 grid place-items-center text-xl\">${h.icon}</span>\n          <div class=\"flex-1 min-w-0\">\n            <div class=\"habit-name text-sm font-medium truncate\">${h.name}</div>\n            <div class=\"text-[11px] text-zinc-500\">${h.meta}</div>\n          </div>\n          <span class=\"habit-check w-7 h-7 rounded-full border-2 border-white/20 grid place-items-center\">\n            <svg class=\"tick w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 13l4 4L19 7\"/></svg>\n          </span>`;\n        li.addEventListener('click', () => { h.done = !h.done; update(); render(); });\n        list.appendChild(li);\n      });\n    }\n    function update() {\n      const done = habits.filter(h => h.done).length;\n      const pct = done / habits.length;\n      ring.style.strokeDashoffset = C * (1 - pct);\n      document.getElementById('pct').textContent = Math.round(pct * 100) + '%';\n      document.getElementById('countLabel').textContent = `${done} / ${habits.length}`;\n      const all = done === habits.length;\n      document.getElementById('streakNum').textContent = baseStreak + (all ? 1 : 0);\n      document.getElementById('streakMsg').textContent = all ? 'Streak extended \u2014 you\\'re on fire! \ud83c\udf89' : `${habits.length - done} to go to extend your streak.`;\n    }\n    render(); update();\n\n    // Heatmap\n    const hm = document.getElementById('heatmap');\n    const colors = ['rgba(255,255,255,.07)', 'rgba(255,106,61,.35)', 'rgba(255,106,61,.6)', 'rgba(255,77,126,.85)', '#8b5cf6'];\n    let seed = 7;\n    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;\n    const weeks = 30;\n    for (let w = 0; w < weeks; w++) {\n      for (let d = 0; d < 7; d++) {\n        const trend = 0.35 + (w / weeks) * 0.6;\n        const r = rnd();\n        let lvl = r > trend + 0.2 ? 0 : r > trend ? 1 : r > trend * 0.6 ? 2 : r > trend * 0.3 ? 3 : 4;\n        if (rnd() < trend * 0.55) lvl = Math.max(lvl, 3 + (rnd() > .5 ? 1 : 0));\n        if (rnd() < 0.08) lvl = 0;\n        const cell = document.createElement('span');\n        cell.className = 'block aspect-square rounded-[4px] min-w-[10px] hover:scale-125 transition';\n        cell.style.background = colors[lvl];\n        hm.appendChild(cell);\n      }\n    }\n    hm.style.gridTemplateColumns = `repeat(${weeks}, minmax(0, 1fr))`;\n    hm.style.gridAutoFlow = 'column';\n\n    // Reveal on scroll\n    const io = new IntersectionObserver((entries) => {\n      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });\n    }, { threshold: 0.12 });\n    document.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n    // Count up\n    const cio = new IntersectionObserver((entries) => {\n      entries.forEach(e => {\n        if (!e.isIntersecting) return;\n        const el = e.target, target = parseFloat(el.dataset.count), suffix = el.dataset.suffix || '';\n        const dec = String(target).includes('.') ? 1 : 0, start = performance.now(), dur = 1400;\n        const tick = (t) => {\n          const p = Math.min((t - start) / dur, 1), eased = 1 - Math.pow(1 - p, 3);\n          el.textContent = (target * eased).toFixed(dec) + suffix;\n          if (p < 1) requestAnimationFrame(tick);\n        };\n        requestAnimationFrame(tick);\n        cio.unobserve(el);\n      });\n    }, { threshold: 0.6 });\n    document.querySelectorAll('[data-count]').forEach(el => cio.observe(el));\n\n    // Pricing toggle\n    const mBtn = document.getElementById('mBtn'), yBtn = document.getElementById('yBtn');\n    function setBilling(yearly) {\n      document.getElementById('proPrice').textContent = yearly ? '$3.99' : '$5.99';\n      document.getElementById('famPrice').textContent = yearly ? '$6.67' : '$9.99';\n      document.getElementById('proNote').textContent = yearly ? 'Billed $47.88 yearly' : 'Billed monthly';\n      document.getElementById('famNote').textContent = yearly ? 'Billed $80.00 yearly' : 'Billed monthly';\n      const on = 'grad-bg text-white shadow-lg', off = 'text-zinc-400 hover:text-white';\n      mBtn.className = 'px-5 py-2 rounded-full font-semibold transition ' + (yearly ? off : on);\n      yBtn.className = 'px-5 py-2 rounded-full font-semibold transition flex items-center gap-2 ' + (yearly ? on : off);\n    }\n    mBtn.addEventListener('click', () => setBilling(false));\n    yBtn.addEventListener('click', () => setBilling(true));\n    setBilling(true);\n\n    // Email form\n    document.getElementById('waitForm').addEventListener('submit', (e) => {\n      e.preventDefault();\n      const msg = document.getElementById('formMsg');\n      msg.textContent = '\ud83c\udf89 You\\'re in! Check your inbox for the download link.';\n      msg.classList.add('text-emerald-300');\n      e.target.reset();\n    });\n  </script>\n</body>\n</html>\n```"}